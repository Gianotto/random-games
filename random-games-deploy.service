[Unit]
Description=Random Games Weekly Deploy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=gianotto
WorkingDirectory=/home/gianotto/randon-games
ExecStart=/home/gianotto/randon-games/deploy.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
